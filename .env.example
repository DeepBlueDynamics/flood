# Copy this to .env and fill in your values
# cp .env.example .env

# Required — Google API key with Veo 3 access
GOOGLE_API_KEY=your-google-api-key-here

# FFmpeg mode:
#   local  — uses the system ffmpeg binary (default on Mac / Cloud Run)
#   docker — uses the nemisis8:latest container (Windows dev)
FFMPEG_MODE=local

# Web server port (default 8080)
PORT=8080
